# =============================================================================
# Week 24 — URL Shortener | .env.example
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# A long random secret string — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 in development, 0 (or omit) in production
FLASK_DEBUG=0

# The publicly accessible base URL of your app (no trailing slash)
# Used to build short URLs — do NOT use request.host_url in code (Host Header Injection risk)
BASE_URL=http://127.0.0.1:5000

# Comma-separated list of allowed CORS origins (your frontend domain(s))
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
